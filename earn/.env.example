# Leave any key blank and that step runs in DRY-RUN mode (logs what it would do).

# Public URL of your server (Fly gives you https://<app>.fly.dev)
BASE_URL=http://localhost:8080
PORT=8080
BOOKS_DIR=./books

# Writer: Anthropic API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# What the agent writes about (it picks one specific, underserved topic)
NICHE_SEEDS=productivity for new managers, gratitude journal for nurses, budgeting for freelancers, sourdough for beginners
BOOK_PRICE_CENTS=900

# Sales: Stripe secret key + webhook signing secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Ads: Meta Marketing API
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=          # digits only, without "act_"
META_PAGE_ID=
META_API_VERSION=v23.0
META_DAILY_BUDGET_CENTS=500
META_MAX_DAILY_BUDGET_CENTS=1000   # hard cap the agent can never exceed
META_AUTO_ACTIVATE=false           # false = ads are created PAUSED for you to review
META_COUNTRIES=US

# Automation
ADMIN_TOKEN=change-me              # protects POST /admin/run
AGENT_EVERY_HOURS=0                # 0 = only run on demand; 168 = a new book weekly
